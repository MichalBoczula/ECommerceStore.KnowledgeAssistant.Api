KA_CORPUS_PATH=examples/demo-corpus.json
KA_RETRIEVAL_MODE=local
KA_GENERATION_MODE=evidence
# Azure mode requires a real ingested corpus and the matching index.
# KA_SEARCH_ENDPOINT=https://YOUR-SERVICE.search.windows.net
# KA_SEARCH_INDEX=knowledge-v1
# KA_SEARCH_KEY=
# KA_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
# KA_OPENAI_KEY=
# KA_EMBEDDING_DEPLOYMENT=
# KA_EMBEDDING_DIMENSIONS=1536
# KA_EMBEDDING_REVISION=1
# KA_CHAT_DEPLOYMENT=
# Foundry generation uses the saved agent endpoint and an Entra identity.
# KA_GENERATION_MODE=foundry
# KA_FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
# KA_FOUNDRY_AGENT_NAME=ecommerce-knowledge-assistant
# KA_MAX_OUTPUT_TOKENS=6000
# KA_API_KEY=
# KA_CORS_ORIGINS=["http://localhost:4200"]
